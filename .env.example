# Project portal at /admin
ADMIN_PASSWORD=
# From your Vercel Blob store (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# ChatGPT-powered "Ask anything about Designjoy" box
OPENAI_API_KEY=
# Optional: override the model used for chat answers
OPENAI_MODEL=gpt-4o-mini

# Stripe checkout (Stripe → Developers → API keys). Use test keys (sk_test_/pk_test_) first.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Each plan's monthly price ID (price_…) — a product ID (prod_…) also works
STRIPE_PRICE_MONTHLY_CLUB=
STRIPE_PRICE_DESIGN_PARTNER=
# Optional: the customer portal login link (defaults to the test link in content/site.ts)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
